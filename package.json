{
  "name": "magpie-aside",
  "version": "0.1.6",
  "description": "magpie provider plugin: Aside subscription models through the Aside AI gateway",
  "type": "module",
  "main": "./index.mjs",
  "files": [
    "index.mjs",
    "src",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "magpie",
    "aside"
  ],
  "license": "MIT",
  "author": "top728272-oss",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/top728272-oss/magpie-aside.git"
  },
  "bugs": {
    "url": "https://github.com/top728272-oss/magpie-aside/issues"
  },
  "homepage": "https://github.com/top728272-oss/magpie-aside#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "e2e": "node scripts/e2e.mjs",
    "probe": "node scripts/probe.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "magpie": {
    "name": "Aside",
    "summary": {
      "en": "Use Aside subscription models in every agent: reads the signed-in Aside browser account, routes each model to its own endpoint, and keeps the session token fresh.",
      "zh": "在每个 agent 里使用 Aside 订阅模型：读取本机已登录的 Aside 浏览器账号，按模型自动选择端点，并保持会话令牌有效。"
    },
    "options": {
      "lang": "auto",
      "showHiddenModels": false,
      "allowRefresh": true,
      "dataDir": "",
      "baseOrigin": "https://api.aside.com",
      "debug": false
    },
    "maxConcurrency": 4,
    "icon": "data:image/svg+xml;base64,"
  },
  "devDependencies": {
    "prettier": "^3.10.1"
  }
}
